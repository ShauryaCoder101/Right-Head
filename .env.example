# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://recruitiq:recruitiq_dev@localhost:5432/recruitiq_dev?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────
# Redis connection string for BullMQ job queues and caching
REDIS_URL="redis://localhost:6379"

# ─── Authentication ────────────────────────────────────────────────────
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET="change-me-to-a-random-64-char-string-in-production"
# Access token lifetime (e.g., 15m, 1h)
JWT_ACCESS_EXPIRY="15m"
# Refresh token lifetime (e.g., 7d, 30d)
JWT_REFRESH_EXPIRY="7d"

# ─── OpenAI / LLM ─────────────────────────────────────────────────────
# Your OpenAI API key
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ─── Server ────────────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3000
# Environment: development, test, production
NODE_ENV="development"

# ─── File Uploads ──────────────────────────────────────────────────────
# Maximum upload size per file in megabytes
MAX_UPLOAD_SIZE_MB=25

# ─── Batch Processing ─────────────────────────────────────────────────
# Number of concurrent jobs per worker
BATCH_CONCURRENCY=10

# ─── Enrichment ────────────────────────────────────────────────────────
# Number of days to cache enrichment data before re-fetching
ENRICHMENT_CACHE_DAYS=30

# ─── Email (Nodemailer) ───────────────────────────────────────────────
# SMTP host for sending emails (e.g., verification codes)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@recruitiq.dev"

# ─── Client ───────────────────────────────────────────────────────────
# Frontend URL for CORS and email links
CLIENT_URL="http://localhost:5173"
